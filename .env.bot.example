# Copy to the deployment's .env. Docker Compose already uses env_file: .env.
# test: current public demo, fresh conversation on each visit.
# production: confirmed appointment + private link + one interview per appointment.
CONSULTATION_BOT_MODE=test
# Required only before enabling production. Generate an independent random key
# of at least 32 characters; back it up securely, never commit it or rotate it
# without re-encrypting existing final reports. Test mode does not store reports.
# CONSULTATION_BOT_REPORT_KEY=
